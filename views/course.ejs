<% layout("layout/boilerplate") -%>

<div class="container py-5">
  <div class="row mb-5">
    <div class="col-lg-8">
      <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-2 fw-semibold">
        📂 Your Library
      </span>
      <h1 class="fw-bold display-5 mb-2">My Courses</h1>
      <p class="text-muted lead fs-6">Manage, track, and continue learning from your AI-generated courses.</p>
    </div>
  </div>

  <% if (courses && courses.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% for(let course of courses) { %>
        <div class="col">
          <div class="card border-0 shadow-sm rounded-4 h-100 bg-white d-flex flex-column transition-hover">
            <div class="card-body p-4 d-flex flex-column">
              
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill small fw-semibold">
                  AI Course
                </span>
                <% if (course.status === "generating") { %>
                  <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 rounded-pill small">Generating...</span>
                <% } else if (course.status === "failed") { %>
                  <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill small">Failed</span>
                <% } else { %>
                  <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill small">Ready</span>
                <% } %>
              </div>
              <% if(course.image && course.image.url){%>
                <img src="<%= course.image.url %>" class="card-img-top" alt="<%= course.title %>" style="height: 180px; object-fit: cover;">
              <%}%> 
              <h5 class="card-title fw-bold text-dark mb-2 fs-5"><%= course.title %></h5>
              
              <p class="card-text text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                <%= course.description %>
              </p>
              <div class="mt-auto pt-2 border-top border-light">
                <a href="/skillbuzz/courses/<%= course._id %>" class="btn btn-outline-primary btn-sm w-100 rounded-pill py-2 fw-semibold">
                  View Course &rarr;
                </a>
              </div>

            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-light">
      <div class="display-4 mb-3">📚</div>
      <h3 class="fw-bold mb-2">No courses found</h3>
      <p class="text-muted small mb-4">You haven't created any AI courses yet. Get started by turning your ideas into a curriculum!</p>
      <div>
        <a href="/skillbuzz/new" class="btn btn-primary btn-lg px-4 shadow-sm">✨ Create Your First Course</a>
      </div>
    </div>
  <% } %>

</div>