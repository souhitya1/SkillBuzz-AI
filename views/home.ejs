<% layout("layout/boilerplate") -%>

<div class="px-4 py-5 my-5 text-center">
  <h1 class="display-4 fw-bold tracking-tight mb-3">Turn any idea into a course</h1>
  <div class="col-lg-7 mx-auto">
    <p class="lead text-muted mb-4">
      SkillBuzz AI takes your topic and description, and instantly generates a complete,
      structured course — modules, lessons, and a final test — powered by AI.
    </p>
    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mb-5">
      <a href="/skillbuzz/new" class="btn btn-primary btn-lg px-4 gap-3 shadow-sm">Create a Course</a>
      <a href="/skillbuzz/courses" class="btn btn-outline-secondary btn-lg px-4">My Courses</a>
    </div>
  </div>
</div>

<div class="bg-light border-top border-bottom py-4 mb-5">
  <div class="container">
    <div class="row text-center g-4">
      <div class="col-md-4">
        <h3 class="fw-bold text-primary mb-1">Instant Generation</h3>
        <p class="text-muted small mb-0">From prompt to structured curriculum in seconds</p>
      </div>
      <div class="col-md-4">
        <h3 class="fw-bold text-primary mb-1">100% Tailored</h3>
        <p class="text-muted small mb-0">Custom modules and lessons built for your precise goal</p>
      </div>
      <div class="col-md-4">
        <h3 class="fw-bold text-primary mb-1">Mastery Checked</h3>
        <p class="text-muted small mb-0">Gated final assessments to ensure true understanding</p>
      </div>
    </div>
  </div>
</div>

<div class="container px-4 py-5">
  <div class="text-center mb-5">
    <h2 class="fw-bold">Everything you need to master new skills</h2>
    <p class="text-muted">A lightweight, smart alternative to manual course curation.</p>
  </div>
  <div class="row g-4 py-3 row-cols-1 row-cols-lg-3">
    <div class="col d-flex align-items-start">
      <div class="icon-square bg-primary bg-gradient text-white flex-shrink-0 me-3 rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.5rem;">
        📝
      </div>
      <div>
        <h4 class="fw-bold mb-1">Just describe it</h4>
        <p class="text-muted">Give a title and a short description. No need to plan the structure yourself — AI handles it.</p>
      </div>
    </div>
    <div class="col d-flex align-items-start">
      <div class="icon-square bg-primary bg-gradient text-white flex-shrink-0 me-3 rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.5rem;">
        📚
      </div>
      <div>
        <h4 class="fw-bold mb-1">Structured learning</h4>
        <p class="text-muted">Get organized modules and lessons with clear, detailed content generated specifically for your topic.</p>
      </div>
    </div>
    <div class="col d-flex align-items-start">
      <div class="icon-square bg-primary bg-gradient text-white flex-shrink-0 me-3 rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.5rem;">
        ✅
      </div>
      <div>
        <h4 class="fw-bold mb-1">Track your progress</h4>
        <p class="text-muted">Mark lessons complete as you go, then pass a final test to officially complete the course.</p>
      </div>
    </div>
  </div>
</div>

<div class="bg-light py-5 my-5">
  <div class="container px-4 py-3">
    <div class="text-center mb-5">
      <h2 class="fw-bold">How SkillBuzz AI Works</h2>
      <p class="text-muted">Get started on your learning journey in three simple steps.</p>
    </div>
    <div class="row g-4 align-items-center">
      <div class="col-md-4 text-center">
        <div class="bg-white p-4 rounded-3 shadow-sm h-100 border-0">
          <div class="display-5 text-primary fw-bold mb-3">01</div>
          <h5 class="fw-bold">Enter Your Topic</h5>
          <p class="text-muted small mb-0">Provide a brief course title and describe what you want to learn or master.</p>
        </div>
      </div>
      <div class="col-md-4 text-center">
        <div class="bg-white p-4 rounded-3 shadow-sm h-100 border-0">
          <div class="display-5 text-primary fw-bold mb-3">02</div>
          <h5 class="fw-bold">AI Generates Curriculum</h5>
          <p class="text-muted small mb-0">AI structures customized modules, comprehensive lessons, and assessments.</p>
        </div>
      </div>
      <div class="col-md-4 text-center">
        <div class="bg-white p-4 rounded-3 shadow-sm h-100 border-0">
          <div class="display-5 text-primary fw-bold mb-3">03</div>
          <h5 class="fw-bold">Learn & Test</h5>
          <p class="text-muted small mb-0">Track your progress bar, finish lessons, and pass the final test to certify mastery.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container px-4 py-5">
  <div class="p-5 text-center bg-primary text-white rounded-4 shadow-sm position-relative overflow-hidden">
    <div class="position-relative z-1">
      <h2 class="fw-bold mb-3">Ready to build your first course?</h2>
      <p class="col-lg-8 mx-auto mb-4 opacity-75">
        Whether it's a technical skill, a hobby, or something you've always wanted to learn —
        turn it into a structured course in seconds.
      </p>
      <a href="/skillbuzz/new" class="btn btn-light btn-lg px-5 text-primary fw-semibold shadow-sm">Get Started</a>
    </div>
  </div>
</div>