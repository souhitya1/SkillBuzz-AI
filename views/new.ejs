<% layout("layout/boilerplate") -%>
<br>
<form action="/skillbuzz/courses" method="post">
  <div class="mb-3">
    <label for="exampleInputtitlecouse1" class="form-label">Course Title</label>
    <input type="text" name="title" class="form-control" id="exampleInputtitlecouse1" required>
  </div>
  <div class="mb-3">
    <label for="exampleInputDescription1" class="form-label">Course Description</label>
    <textarea name="description" class="form-control" id="exampleInputDescription1" rows="3" required></textarea>
  </div>

  <button type="submit" class="btn btn-primary">Submit</button>
</form>