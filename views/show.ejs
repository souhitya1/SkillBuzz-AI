<% layout("layout/boilerplate") -%>

<% if (course.status === "generating") { %>
  <meta http-equiv="refresh" content="4">
<% } %>

<h2><%= course.title %></h2>
<p class="text-muted"><%= course.description %></p>

<% if (course.status === "generating") { %>
  <div class="alert alert-info">Your course is being generated. This page will refresh automatically...</div>
<% } else if (course.status === "failed") { %>
  <div class="alert alert-danger">Course generation failed. Please try again.</div>
<% } else { %>

  <% let totalLessons = 0; %>
  <% course.modules.forEach(m => totalLessons += m.lessons.length); %>
  <% let percent = totalLessons > 0 ? Math.round((progress.completedLessons.length / totalLessons) * 100) : 0; %>

  <div class="progress mb-4" style="height: 20px;">
    <div class="progress-bar bg-success" style="width: <%= percent %>%"><%= percent %>%</div>
  </div>

  <% if (progress.courseCompleted) { %>
    <div class="alert alert-success">🎉 Course completed! You passed the final test.</div>
  <% } else if (percent >= 80) { %>
    <div class="alert alert-warning">
      You've completed <%= percent %>% of the lessons. Take the final test to complete this course!
    </div>
    <form action="/skillbuzz/courses/<%= course._id %>/finaltest" method="POST">
      <% course.finalTest.forEach(function(q, qi) { %>
        <div class="mb-3">
          <p><strong><%= q.question %></strong></p>
          <% q.options.forEach(function(opt) { %>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="answer<%= qi %>" value="<%= opt %>" required>
              <label class="form-check-label"><%= opt %></label>
            </div>
          <% }) %>
        </div>
      <% }) %>
      <button type="submit" class="btn btn-primary">Submit Final Test</button>
    </form>
  <% } %>

  <div class="accordion mt-4" id="courseAccordion">
    <% for (let i = 0; i < course.modules.length; i++) { %>
      <% let mod = course.modules[i]; %>
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#module<%= i %>">
            <%= mod.title %>
          </button>
        </h2>
        <div id="module<%= i %>" class="accordion-collapse collapse" data-bs-parent="#courseAccordion">
          <div class="accordion-body">
            <% for (let j = 0; j < mod.lessons.length; j++) { %>
              <% let lesson = mod.lessons[j]; %>
              <% let key = i + "-" + j; %>
              <% let isDone = progress.completedLessons.includes(key); %>

              <h5><%= lesson.title %> <% if (isDone) { %> ✅ <% } %></h5>
              <p><%= lesson.content %></p>

              <form action="/skillbuzz/courses/<%= course._id %>/complete/<%= key %>" method="POST">
                <button type="submit" class="btn btn-sm btn-<%= isDone ? 'secondary' : 'success' %>">
                  <%= isDone ? 'Mark Incomplete' : 'Mark Complete' %>
                </button>
              </form>
              <hr>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>

<% } %>