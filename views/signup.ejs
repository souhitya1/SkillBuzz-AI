<% layout("layout/boilerplate") -%>
    <form action="/skillbuzz/signup" method="post" class="needs-validation" novalidate>
      <br>
    <div class="mb-3">
       <label for="exampleInputusername1" class="form-label">Username</label>
       <input type="text" class="form-control" name="username" id="exampleInputusername1" autocomplete="username">
       <div class="valid-feedback">
      Looks good!
    </div>
    </div>
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">Email address</label>
    <input type="email" name="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" autocomplete="email">
    <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
  </div>
  <div class="mb-3">
    <label for="exampleInputPassword1" class="form-label">Password</label>
    <input type="password" name="password" class="form-control" id="exampleInputPassword1" autocomplete="new-password">
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
</form>